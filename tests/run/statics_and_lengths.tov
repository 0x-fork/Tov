// Static fields that aren't readonly are module state; `xs.length = n` drops elements; `xs[xs.length]
// = v` appends, also to arrays that are pushed onto.
class Config {
  static DP = 20
  static RM = 1
  static label = "big"
  static readonly MAX = 100
  static bump(): int {
    Config.DP += 1
    return Config.DP
  }
}

class Item {
  name: string
  constructor(name: string) {
    this.name = name
  }
}

function main() {
  console.log(Config.DP, Config.label, Config.MAX)
  Config.DP = 34
  Config.label = Config.label + "!"
  Config.bump()
  console.log(Config.DP, Config.label)
  Config.RM = 2.5
  console.log(Config.RM)

  const xs: int[] = [1, 2, 3, 4, 5]
  xs.length = 3
  console.log(xs, xs.length)
  xs.length -= 1
  console.log(xs)
  const items = [new Item("a"), new Item("b"), new Item("c")]
  items.length = 1
  console.log(items.map((i) => i.name))
  const ys: int[] = [9, 8, 7, 6]
  let sum = 0
  for (let i = 0; i < ys.length; i++) {
    sum += ys[i]!
    if (i === 1) ys.length = 2
  }
  console.log(sum, ys)

  const zs: int[] = []
  for (let i = 0; i < 5; i++) {
    zs.push(i)
    zs[zs.length] = i * 10
  }
  console.log(zs)
  const big: int[] = []
  for (let i = 0; i < 100000; i++) {
    big.push(i)
    if (i % 3 === 0) big[big.length] = -i
  }
  console.log(big.length, big[big.length - 1])
}
