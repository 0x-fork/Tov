// A loop that calls a closure shrinking the array it indexes keeps its bounds checks.
function main() {
  let xs = [1, 2, 3, 4, 5]
  const shrink = () => {
    xs.pop()
    xs.pop()
    xs.pop()
  }
  let s = 0
  for (let i = 0; i < 5; i++) {
    if (i === 1) shrink()
    s += xs[i]!
  }
  console.log(s)
}
