let counter = 0

type Point = { x: f64, y: f64 }

function nudge(p: Point) {
  p.x += 1
}

function grow(xs: int[]) {
  xs.push(1)
}

function fill(inout xs: int[]) {
  xs.push(2)
}

function main() {
  const limit = 10
  limit = 20
  const items: int[] = []
  fill(items)
  const pts: Point[] = [{ x: 0, y: 0 }]
  for (const p of pts) {
    p.x = 5
  }
}

type Cell = { v: int, kids: int[] }
class Holder { items: int[] = [] }

function elementAlias() {
  const grid: int[][] = [[0, 0], [0, 0]]
  const row = grid[0]!
  row[1] = 5
  console.log(grid[0]![1])
  grid[1] = [7]
  console.log(row[0])
}

function storedThenChanged() {
  const cells: Cell[] = []
  const c: Cell = { v: 1, kids: [] }
  cells.push(c)
  c.v = 2
  console.log(cells.length)
}

function fieldAlias(h: Holder) {
  const xs = h.items
  xs.push(1)
}

// Changed in place and also reassigned: TypeScript would change the caller's array, then rebind
// only the parameter, so it stays an error.
function rebinds(xs: int[]) {
  xs.push(1)
  xs = []
  console.log(xs.length)
}
