// Counters and DP tables only ever stepped by one from small values run without overflow checks;
// these compute the same results as with them.
function levenshtein(a: string, b: string): int {
  let prev: int[] = []
  let curr: int[] = []
  for (let i = 0; i <= a.length; i++) {
    prev.push(i)
    curr.push(0)
  }
  for (let j = 1; j <= b.length; j++) {
    curr[0] = j
    for (let i = 1; i <= a.length; i++) {
      const cost = a[i - 1] === b[j - 1] ? 0 : 1
      curr[i] = Math.min(prev[i]! + 1, curr[i - 1]! + 1, prev[i - 1]! + cost)
    }
    const tmp = prev
    prev = curr
    curr = tmp
  }
  return prev[a.length]!
}

function main() {
  console.log(levenshtein("kitten", "sitting"), levenshtein("", "abc"), levenshtein("flaw", "lawn"))
  let flips = 0
  let down = 3
  for (let i = 0; i < 1000; i++) {
    if (i % 7 === 0) flips++
    down--
  }
  console.log(flips, down, -flips)
}
