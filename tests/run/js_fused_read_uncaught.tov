// Reads fused into one engine call with no call among them (`o.a.b`), in a closure whose type says
// nothing about throwing: a getter that throws passes its error on, as each read alone does (the
// closure's type throws then, as in TypeScript), and uncaught it ends the program.
// (Caught: tests/run/js_read_errors.)
import { runInThisContext } from "node:vm"

function main() {
  const o = runInThisContext("({ a: { get b() { throw new TypeError('bad b') } } })")
  console.log("before")
  const read: (n: int) => Js = (n: int): Js => o.a.b
  console.log(read(1))
  console.log("never: after the read")
}
