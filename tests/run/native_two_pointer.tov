// Two-pointer loops (`while (i < j) { ...; i++; j-- }`): the same results with indexes known in
// range before the loop (its unchecked copy) or not, and `i`, `j` stepped anywhere in the body.
function reverse(inout xs: int[]) {
  let i = 0
  let j = xs.length - 1
  while (i < j) {
    const t = xs[i]!
    xs[i] = xs[j]!
    xs[j] = t
    i++
    j--
  }
}

function isPalindrome(s: u8[]): bool {
  let lo = 0
  let hi = s.length - 1
  while (lo < hi) {
    lo += 1
    hi -= 1
    if (s[lo - 1]! !== s[hi + 1]!) return false
  }
  return true
}

function main() {
  let xs = [1, 2, 3, 4, 5, 6, 7]
  reverse(&xs)
  console.log(xs.join(","))
  let one = [9]
  reverse(&one)
  let none: int[] = []
  reverse(&none)
  console.log(one.join(","), none.length)
  const enc = new TextEncoder()
  console.log(isPalindrome(enc.encode("racecar")), isPalindrome(enc.encode("abca")), isPalindrome(enc.encode("")))
  // a shared array: the copy-on-write copy is the one reversed
  let a = [1, 2, 3]
  const b = a.slice()
  reverse(&a)
  console.log(a.join(","), b.join(","))
}
