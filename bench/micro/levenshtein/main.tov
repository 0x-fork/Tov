// Levenshtein distance (two-row DP, byte comparisons) between every pair of N words
// generated with a Park-Miller LCG. Prints the minimum distance and the sum of all distances.

function levenshtein(s: u8[], t: u8[]): int {
  let a = s
  let b = t
  if (a.length > b.length) {
    a = t
    b = s
  }
  const m = a.length
  const n = b.length
  let prev: int[] = []
  let curr: int[] = []
  for (let i = 0; i <= m; i++) {
    prev.push(i)
    curr.push(0)
  }
  for (let j = 1; j <= n; j++) {
    curr[0] = j
    const bj = b[j - 1]!
    for (let i = 1; i <= m; i++) {
      const cost = a[i - 1]! === bj ? 0 : 1
      curr[i] = Math.min(prev[i]! + 1, curr[i - 1]! + 1, prev[i - 1]! + cost)
    }
    const tmp = prev
    prev = curr
    curr = tmp
  }
  return prev[m]!
}

function main() {
  const alphabet = ["a", "b", "c", "d", "e", "f", "g", "h"]
  const count = 800
  let state = 42
  const encoder = new TextEncoder()
  const words: u8[][] = []
  for (let w = 0; w < count; w++) {
    state = (state * 16807) % 2147483647
    const len = 20 + (state % 41)
    let s = ""
    for (let k = 0; k < len; k++) {
      state = (state * 16807) % 2147483647
      s += alphabet[state % 8]!
    }
    words.push(encoder.encode(s))
  }
  let minDist = -1
  let total = 0
  for (let i = 0; i < count; i++) {
    for (let j = i + 1; j < count; j++) {
      const d = levenshtein(words[i]!, words[j]!)
      if (minDist < 0 || d < minDist) minDist = d
      total += d
    }
  }
  console.log(`${minDist} ${total}`)
}
