// Strings as JavaScript sees them: lengths and indexes count UTF-16 code units.

function digitSum(s: string): number {
  let sum = 0
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i)
    if (c >= 48 && c <= 57) sum += c - 48
  }
  return sum
}

function codes(s: string): string {
  const out: string[] = []
  for (let i = 0; i < s.length; i++) out.push(s.charCodeAt(i).toString(16))
  return out.join(" ")
}

function backwards(s: string): string {
  let out = ""
  for (let i = s.length - 1; i >= 0; i--) out += s.charCodeAt(i).toString(16) + " "
  return out
}

function main() {
  const samples = ["hello", "", "héllo", "a😀b", "日本語のテキスト", "é", "😀😀😀", "x1y2😀z3"]
  for (const s of samples) {
    console.log(s.length, codes(s), "|", backwards(s), digitSum(s))
  }

  const t = "a😀b日本c"
  console.log(t.length, t.indexOf("b"), t.indexOf("日"), t.indexOf("c"), t.indexOf("😀"), t.indexOf("z"), t.lastIndexOf("本"))
  console.log(t.slice(0, 1), t.slice(1, 3), t.slice(3), t.slice(-3), t.slice(-2, -1), t.slice(4, 2) === "")
  console.log(t.substring(5, 1), t.substring(3), t.substr(1, 2), t.substr(-2))
  console.log(t.charAt(3), t.charAt(99) === "", t[0], t[3], t[5], t[99] === undefined, t.at(-1), t.at(10) === undefined)
  console.log(t.codePointAt(1), t.codePointAt(2), t.codePointAt(0), t.codePointAt(50) === undefined)
  console.log(t.charCodeAt(1), t.charCodeAt(2), t.charCodeAt(1) >= 48 && t.charCodeAt(1) <= 57)
  console.log("abc".charCodeAt(5) === 10, "abc".charCodeAt(), "abcabc".indexOf("c", 3), "abcabc".lastIndexOf("a", 2), "abc".indexOf("", 9))
  console.log("héllo wörld".includes("wö", 3), "héllo".startsWith("ll", 2), "héllo".endsWith("é", 2), "héllo".startsWith("h"))

  // round trips through indexes
  const line = "name=Zoë; city=Kraków; emoji=🎉!"
  let at = 0
  while (true) {
    const eq = line.indexOf("=", at)
    if (eq < 0) break
    const semi = line.indexOf(";", eq)
    const end = semi < 0 ? line.length : semi
    console.log(line.slice(at, eq).trim(), "->", line.slice(eq + 1, end), end - eq - 1)
    at = end + 1
  }

  console.log("ab😀".split("").length, "ab".split(""), "日本".split(""), "a,b😀,c".split(","))
  console.log("5".padStart(3, "0"), "日".padEnd(4, "ab"), "x".padStart(4, "日本"), "😀".padStart(4, "-"))
  console.log(String.fromCharCode(72, 105), String.fromCharCode(0x65e5), String.fromCharCode(0xd83d, 0xde00), String.fromCodePoint(0x1f600, 65))
  console.log("ab".concat("c", "dé"), "x".concat())
  let s = ""
  for (let i = 0; i < 26; i++) s += String.fromCharCode(97 + i)
  console.log(s, s.length, s[25], s.charCodeAt(25))
  const word = "straße"
  const counts: number[] = []
  for (let i = 0; i < 26; i++) counts.push(0)
  for (let i = 0; i < word.length; i++) {
    const c = word.charCodeAt(i) - 97
    if (c >= 0 && c < 26) counts[c] = counts[c]! + 1
  }
  console.log(counts.join(""))

  // a long string indexed many times (and two at once)
  let long = ""
  for (let i = 0; i < 300; i++) long += i % 7 === 0 ? "😀" : i % 5 === 0 ? "é" : String.fromCharCode(97 + (i % 26))
  const cps: string[] = []
  for (const c of long) cps.push(c)
  const other = cps.reverse().join("") + "日本"
  let h = 0
  for (let r = 0; r < 3; r++) {
    for (let i = 0; i < long.length; i++) h = (h * 31 + long.charCodeAt(i) + other.charCodeAt(i % other.length)) | 0
    for (let i = long.length - 1; i >= 0; i -= 3) h = (h * 17 + (long.codePointAt(i) ?? 0)) | 0
  }
  console.log(long.length, other.length, h, long.slice(100, 110), long.indexOf("é", 200), long.lastIndexOf("😀"))

  // for...of walks code points (an emoji is one step, though two units)
  for (const w of ["a😀b", "日本", "é", ""]) {
    const seen: string[] = []
    for (const c of w) seen.push(`${c}:${c.length}`)
    console.log(seen.join(" "), seen.length, w.length)
  }
}
