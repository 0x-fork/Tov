// Values reached through calls and top-level bindings are copies in Tov, shared in TypeScript:
// changing one where the other is read again is an error, not a silent difference.
interface Task {
  id: number
  done: boolean
}

const grid: number[][] = [[1], [2]]
const row = grid[0]!
row.push(9)
console.log(grid)

function finish(tasks: Task[]) {
  const t = tasks.find((x) => x.id === 1)
  if (t) t.done = true
  console.log(tasks)
}

function group() {
  const m = new Map<string, number[]>()
  m.set("a", [])
  const l = m.get("a")!
  l.push(3)
  console.log(m)
  // (changed where it is: fine)
  m.get("a")!.push(4)
}

// A parameter with a default, changed in place: TypeScript changes the caller's set.
function visit(node: string, seen: Set<string> = new Set()): void {
  seen.add(node)
}
