// `number` holds integers as `int` where only integers reach it, floats elsewhere.
type P = { x: number, y: number }
type Body = { pos: P, mass: number, id: number }

function twice(x: number): number { return x * 2 }
function avg(a: number, b: number): number { return (a + b) / 2 }
function sum(xs: number[]): number {
  let s = 0
  for (const x of xs) s += x
  return s
}
function mid(a: number, b: number): number { return Math.floor((a + b) / 2) }
function fib(n: number): number { return n < 2 ? n : fib(n - 1) + fib(n - 2) }
function half(c: boolean): number { return c ? 1 : 0.5 }
function scaleAll(xs: number[], k: number): number[] { return xs.map((x) => x * k) }
function apply(f: (x: number) => number, v: number): number { return f(v) }
function dflt(x?: number): number { return (x ?? 1.5) + 1 }
function opt(x?: number): number { return (x ?? 2) * 3 }
function rest(...xs: number[]): number { return xs.length + xs[0]! }
function id<T>(x: T): T { return x }
function fact(n: number): number { return n <= 1 ? 1 : n * fact(n - 1) }

class Counter {
  count: number = 0
  rate: number
  constructor(rate: number) { this.rate = rate }
  tick(): void { this.count += this.rate }
}

class Vec {
  constructor(public x: number, public y: number) {}
  len(): number { return Math.sqrt(this.x * this.x + this.y * this.y) }
  static of(n: number): Vec { return new Vec(n, n) }
}

class Animal {
  legs: number
  constructor(legs: number) { this.legs = legs }
}
class Bird extends Animal {
  constructor() { super(2.5) }
}

let seed: number = 42
function rand(): number {
  seed = (seed * 3877 + 29573) % 139968
  return seed
}
let g: number = 1
function bump(): void { g = g * 1.5 }

function main() {
  console.log(twice(3), twice(1.25))
  console.log(avg(1, 2), sum([1, 2, 3]), sum([0.5, 0.25]))
  console.log(mid(3, 8), fib(20), half(true), half(false))
  console.log(scaleAll([1, 2], 3).join(","), scaleAll([1, 2], 0.5).join(","))
  console.log(apply((x) => x + 1, 2), apply((x: number) => x / 4, 2))
  console.log(dflt(), dflt(2), opt(), opt(1.5), rest(1, 2, 3), id<number>(2.5), fact(20))

  let x: number = 0
  x = 0.5
  let t: number = 0
  for (let i = 0; i < 10; i++) t += 0.1
  let q: number = 7
  q = q / 2
  let r: number = 3
  r = Math.sqrt(r)
  console.log(x, t, q, r)

  const xs: number[] = []
  xs.push(1)
  xs.push(2.5)
  const ys: number[] = [4, 5]
  ys[0] = ys[0]! / 8
  console.log(xs.join(" "), ys.join(" "))

  const p: P = { x: 1, y: 2.5 }
  const b: Body = { pos: { x: 3, y: 4 }, mass: 1, id: 7 }
  b.mass = b.mass * 0.75
  b.pos.x += 0.5
  console.log(p.x, p.y, b.pos.x, b.pos.y, b.mass, b.id)

  const c = new Counter(0.25)
  c.tick()
  c.tick()
  const v = new Vec(3, 4)
  const w = Vec.of(1.5)
  console.log(c.count, v.len(), w.x, new Bird().legs)

  const m = new Map<string, number>()
  m.set("a", 1)
  m.set("b", (m.get("a") ?? 0) + 0.5)
  const n = new Map<string, number>()
  n.set("k", 3)
  console.log(m.get("b"), n.get("k"))

  const parsed: P = try JSON.parse('{"x": 0.5, "y": 2}')
  const nums: number[] = try JSON.parse("[1.5, 2]")
  console.log(parsed.x + parsed.y, nums[0]! + nums[1]!)

  for (let i = 0; i < 3; i++) rand()
  bump()
  console.log(seed, g)

  const sorted = [3.5, 1.25, 2].sort((a: number, b: number) => a - b)
  const ints = [3, 1, 2].sort((a: number, b: number) => a - b)
  console.log(sorted.join(","), ints.join(","))

  let acc: number = 0
  const add = (d: number) => { acc += d }
  add(1)
  add(0.5)
  const f: (z: number) => number = (z) => z + 0.5
  console.log(acc, f(1))
  let u: number | undefined = undefined
  u = 1.5
  console.log(u)
}
