// Typed arrays, new Array(n), Array.from/of and fill, as in TypeScript.
function checksum(buf: Uint8Array): number {
  let s = 0
  for (let i = 0; i < buf.length; i++) s = (s * 31 + buf[i]!) % 1000003
  return s
}
function main() {
  const b = new Uint8Array(4)
  b[0] = 255
  b[1] = b[0]! + 10
  b[2] = -1
  b[3] = 3.7
  console.log(b.join(","), b.length, checksum(b))
  const f = new Float64Array([1, 2.5, 3])
  f[1] = f[1]! * 2
  console.log(f.join(","))
  const i32 = new Int32Array(3)
  i32[0] = 2 ** 31
  console.log(i32.join(","))
  const filled = new Array(4).fill(7)
  const grid: number[] = new Array(5).fill(0)
  grid[2] = 9
  console.log(filled.join(","), grid.join(","))
  const sq = Array.from({ length: 5 }, (_, i) => i * i)
  const doubled = Array.from([1, 2, 3], (x) => x * 2)
  const letters = Array.from("abc")
  const copy = Array.from(new Set([3, 1, 3]))
  console.log(sq.join(","), doubled.join(","), letters.join("-"), copy.join(","), Array.of(4, 5).join(","))
  const u = new Uint8Array([300, 20])
  const words: Uint8Array[] = [new TextEncoder().encode("hi"), u]
  console.log(u.join(","), words.length, words[0]!.length, [1, 2, 3, 4].fill(0, 1, 3).join(","))
}
