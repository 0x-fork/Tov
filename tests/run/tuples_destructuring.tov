// Tuples, destructuring, map entries and Object.keys/values/entries.
function minMax(xs: number[]): [number, number] {
  let lo = Infinity, hi = -Infinity
  for (const x of xs) { if (x < lo) lo = x; if (x > hi) hi = x }
  return [lo, hi]
}
function divmod(a: number, b: number): [number, number] { return [Math.floor(a / b), a % b] }
type Entry = [string, number]
function main1() {
  const [lo, hi] = minMax([3, 1, 4, 1, 5])
  const t = divmod(17, 5)
  const [q, r] = t
  const pairs: Entry[] = [["a", 1], ["b", 2]]
  let total = 0
  for (const [name, n] of pairs) total += n
  const { x, y: why, z = 9 } = { x: 1, y: 2, z: undefined as number | undefined }
  let a = 1, b = 2
  ;[a, b] = [b, a]
  const [first, , third, ...others] = [10, 20, 30, 40, 50]
  const sum = ([p, s]: [number, number]) => p + s
  console.log(lo, hi, q, r, t[0], total, x, why, z, a, b, first, third, others.join(","), sum([3, 4]), pairs[1]![0])
}
function main2() {
  const t: [number, string] = [1, "a"]
  const ts: [string, number][] = [["x", 1]]
  console.log(t, ts, JSON.stringify(t), JSON.stringify(ts))
  const back: [string, number][] = JSON.parse('[["y", 2]]')
  console.log(back[0]![0], back[0]![1])
}
function main3() {
  const m = new Map<string, number>([["a", 1], ["b", 2]])
  const m2 = new Map([["x", 10], ["y", 20]])
  m.set("c", 3)
  for (const [k, v] of m) console.log(k, v)
  const pairs = [...m2.entries()]
  console.log(pairs, m2.get("y"), [...m.keys()].join(""))
  const counts: Record<string, number> = { a: 3, b: 1 }
  console.log(Object.keys(counts), Object.values(counts), Object.entries(counts))
  for (const [i, x] of ["p", "q"].entries()) console.log(i, x)
  const best = [...m.entries()].sort((p, q) => q[1] - p[1])[0]!
  console.log(best[0], best[1], Object.keys({ x: 1, y: 2 }))
  const byLen = new Map<number, string[]>()
  for (const w of ["aa", "b", "cc"]) {
    const list = byLen.get(w.length) ?? []
    list.push(w)
    byLen.set(w.length, list)
  }
  for (const [len, ws] of byLen) console.log(len, ws.join(","))
}
function main() {
  main1()
  main2()
  main3()
}
