// Reads fused into one engine call with no call among them (`o.a.b`), where errors can't pass on
// (a closure whose type doesn't throw): a getter that throws is a trap, as each read alone is.
// (Where errors can pass on, the read passes a JsError on instead: tests/run/js_read_errors.)
import { runInThisContext } from "node:vm"

function main() {
  const o = runInThisContext("({ a: { get b() { throw new TypeError('bad b') } } })")
  console.log("before")
  const read: (n: int) => Js = (n: int): Js => o.a.b
  console.log(read(1))
  console.log("never: after the read")
}
