// `x % d` in a loop nest where `d` doesn't change (its reciprocal is worked out once): the same
// remainders as dividing, for every sign and size of `x` and `d`.
function sums(xs: int[], d: int): int {
  let total = 0
  for (let r = 0; r < 2; r++) {
    for (const x of xs) {
      total += x % d
    }
  }
  return total
}

function main() {
  const xs = [0, 1, 2, 3, 7, 8, 9, 100, 12345, -1, -7, -8, -12345, 9223372036854775807, -9223372036854775807 - 1, 4611686018427387904, 1000000007]
  for (const d of [1, 2, 3, 7, 8, 10, 16, 1000000007, 4611686018427387904, 9223372036854775807, -1, -3, -8, -9223372036854775807 - 1]) {
    const out: string[] = []
    for (let i = 0; i < 1; i++) {
      for (const x of xs) out.push(`${x % d}`)
    }
    console.log(d, sums(xs.slice(0, 13), d), out.join(","))
  }
}
