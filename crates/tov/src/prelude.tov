// Built-in declarations visible in every module (unless a module declares the same name).

export class Error {
  message: string
  name: string = "Error"
  constructor(message?: string) {
    this.message = message ?? ""
  }
  toString(): string {
    return this.message === "" ? this.name : `${this.name}: ${this.message}`
  }
}

export class TypeError extends Error {
  constructor(message?: string) {
    super(message)
    this.name = "TypeError"
  }
}

export class RangeError extends Error {
  constructor(message?: string) {
    super(message)
    this.name = "RangeError"
  }
}

export class SyntaxError extends Error {
  constructor(message?: string) {
    super(message)
    this.name = "SyntaxError"
  }
}

/** An error thrown by JavaScript (an npm package): `value` is what was thrown; `name` and
 * `message` are its own when it's an `Error`. */
export class JsError extends Error {
  value: Js
  constructor(name: string, message: string, value: Js) {
    super(message)
    this.name = name
    this.value = value
  }
}

/** (Makes the JsError for a JavaScript exception; called by generated code.) */
export function __jsError(name: string, message: string, value: Js): JsError {
  return new JsError(name, message, value)
}

/** (An error a Tov function passes on to JavaScript: a `JsError` goes back as what JavaScript
 * threw; any other error as a JavaScript `Error` with its name and message. Called by generated
 * code.) */
export function __isJsError(e: Error): boolean {
  return e instanceof JsError
}

export function __jsErrorValue(e: Error): Js {
  return (e as JsError).value
}

export function __errorName(e: Error): string {
  return e.name
}

export function __errorMessage(e: Error): string {
  return e.message
}

/** A regular expression, as JavaScript's (QuickJS's engine underneath; positions count UTF-16
 * code units). An invalid pattern throws a SyntaxError. */
export class RegExp {
  readonly source: string
  readonly flags: string
  lastIndex: int = 0
  private h: int
  readonly global: bool
  readonly ignoreCase: bool
  readonly multiline: bool
  readonly sticky: bool
  readonly unicode: bool
  readonly dotAll: bool
  readonly hasIndices: bool
  constructor(pattern: string, flags?: string) {
    this.h = __native.reCompile(pattern, flags ?? "")
    if (this.h < 0) {
      __reInvalid(__native.takeError())
    }
    this.source = pattern
    this.flags = __native.reFlags(this.h)
    // (read on every match: found once)
    this.global = this.flags.includes("g")
    this.ignoreCase = this.flags.includes("i")
    this.multiline = this.flags.includes("m")
    this.sticky = this.flags.includes("y")
    this.unicode = this.flags.includes("u")
    this.dotAll = this.flags.includes("s")
    this.hasIndices = this.flags.includes("d")
  }
  /** (the compiled expression, for the prelude's string functions) */
  __id(): int { return this.h }
  test(s: string): bool {
    // (as exec, without making the match)
    const keep = this.global || this.sticky
    const end = __native.reTest(this.h, s, keep ? this.lastIndex : 0)
    if (end < 0) {
      if (keep) this.lastIndex = 0
      return false
    }
    if (keep) this.lastIndex = end
    return true
  }
  exec(s: string): RegExpExecArray | null {
    const keep = this.global || this.sticky
    const p = __native.reExec(this.h, s, keep ? this.lastIndex : 0)
    if (p.length === 0) {
      if (keep) this.lastIndex = 0
      return null
    }
    if (keep) this.lastIndex = p[1]!
    return __reMatchOf(this.h, s, p)
  }
  toString(): string {
    return `/${this.source}/${this.flags}`
  }
}

/** A match: its groups (`m[0]` is the whole match; a group that didn't take part is
 * `undefined`), where it starts, the string searched, and the named groups. */
export class RegExpExecArray {
  items: (string | undefined)[]
  index: int
  input: string
  groups: Record<string, string> | undefined
  constructor(items: (string | undefined)[], index: int, input: string, groups: Record<string, string> | undefined) {
    this.items = items
    this.index = index
    this.input = input
    this.groups = groups
  }
  get length(): int { return this.items.length }
  join(separator?: string): string {
    const parts: string[] = []
    for (const x of this.items) parts.push(x ?? "")
    return parts.join(separator ?? ",")
  }
  slice(start?: int, end?: int): (string | undefined)[] {
    return this.items.slice(start ?? 0, end ?? this.items.length)
  }
}

/** (a regular expression literal: JavaScript checks its pattern before the program runs, so
 * making it can't throw; an invalid one traps) */
export function __reLiteral(pattern: string, flags: string): RegExp {
  let re: RegExp | undefined = undefined
  try {
    re = new RegExp(pattern, flags)
  } catch (e) {
    __native.trap(e.message)
  }
  return re!
}

/** (an invalid pattern) */
export function __reInvalid(message: string): never {
  throw new SyntaxError(message)
}

/** (the match `p` of expression `h` in `s` as a RegExpExecArray) */
export function __reMatchOf(h: int, s: string, p: int[]): RegExpExecArray {
  const n = p.length >> 1
  const items: (string | undefined)[] = new Array(n)
  for (let k = 0; k < n; k++) items[k] = p[2 * k]! < 0 ? undefined : s.slice(p[2 * k]!, p[2 * k + 1]!)
  const names = __native.reNames(h)
  let groups: Record<string, string> | undefined = undefined
  for (let i = 1; i < names.length; i++) {
    const name = names[i]!
    if (name === "") continue
    const g: Record<string, string> = groups ?? {}
    const v = items[i]
    if (v !== undefined) g[name] = v
    groups = g
  }
  return new RegExpExecArray(items, p[0]!, s, groups)
}

/** (what a replacement string's `$&`, `$1`, `$<name>`, ... stand for) */
function __reSubst(h: int, s: string, p: int[], rep: string): string {
  if (!rep.includes("$")) return rep
  const ncap = Math.trunc(p.length / 2)
  let out = ""
  let i = 0
  while (i < rep.length) {
    const c = rep[i]!
    if (c !== "$" || i + 1 >= rep.length) {
      out += c
      i++
      continue
    }
    const d = rep.charCodeAt(i + 1)
    if (d === 36) {
      out += "$"
      i += 2
    } else if (d === 38) {
      out += s.slice(p[0]!, p[1]!)
      i += 2
    } else if (d === 96) {
      out += s.slice(0, p[0]!)
      i += 2
    } else if (d === 39) {
      out += s.slice(p[1]!)
      i += 2
    } else if (d >= 48 && d <= 57) {
      let k = d - 48
      let len = 2
      const e = i + 2 < rep.length ? rep.charCodeAt(i + 2) : -1
      if (e >= 48 && e <= 57 && k * 10 + e - 48 < ncap && k * 10 + e - 48 >= 1) {
        k = k * 10 + e - 48
        len = 3
      }
      if (k >= 1 && k < ncap) {
        if (p[2 * k]! >= 0) out += s.slice(p[2 * k]!, p[2 * k + 1]!)
        i += len
      } else {
        out += "$"
        i++
      }
    } else if (d === 60) {
      const close = rep.indexOf(">", i + 2)
      const names = __native.reNames(h)
      if (close < 0 || !names.some((n) => n !== "")) {
        out += "$"
        i++
      } else {
        const name = rep.slice(i + 2, close)
        const k = names.indexOf(name)
        if (k > 0 && p[2 * k]! >= 0) out += s.slice(p[2 * k]!, p[2 * k + 1]!)
        i = close + 1
      }
    } else {
      out += "$"
      i++
    }
  }
  return out
}

/** (where the next search starts after a match: past it, or one unit on for an empty match) */
function __reNext(s: string, p: int[], unicode: bool): int {
  if (p[1]! > p[0]!) return p[1]!
  const c = s.charCodeAt(p[1]!)
  return unicode && c >= 0xd800 && c <= 0xdbff ? p[1]! + 2 : p[1]! + 1
}

/** `s.replace(re, replacement)` (every match with the `g` flag). */
export function __reReplace(s: string, re: RegExp, rep: string): string {
  return __reReplaceWith(s, re, rep, undefined)
}

/** `s.replace(re, (match) => text)`: no groups to make for it. */
export function __reReplaceFn1(s: string, re: RegExp, f: (m: string) => string): string {
  const h = re.__id()
  const global = re.global
  const sticky = re.sticky
  const unicode = re.unicode
  let from = global ? 0 : sticky ? re.lastIndex : 0
  let out = ""
  let last = 0
  let p: int[] = [0, 0, 0, 0, 0, 0, 0, 0]
  while (from <= s.length) {
    p = __native.reExecInto(h, s, from, p)
    if (p.length === 0) {
      if (global || sticky) re.lastIndex = 0
      break
    }
    out += s.slice(last, p[0]!)
    out += f(s.slice(p[0]!, p[1]!))
    last = p[1]!
    if (!global) {
      if (sticky) re.lastIndex = p[1]!
      break
    }
    from = __reNext(s, p, unicode)
  }
  out += s.slice(last)
  return out
}

/** `s.replace(re, (match, ...groups) => text)`. */
export function __reReplaceFn(s: string, re: RegExp, f: (m: string, p1: string, p2: string, p3: string, p4: string, p5: string, p6: string, p7: string, p8: string, p9: string) => string): string {
  return __reReplaceWith(s, re, "", f)
}

function __reReplaceWith(s: string, re: RegExp, rep: string, f: ((m: string, p1: string, p2: string, p3: string, p4: string, p5: string, p6: string, p7: string, p8: string, p9: string) => string) | undefined): string {
  const h = re.__id()
  const global = re.global
  const sticky = re.sticky
  // (a replacement string, `$1`s and all but `$<name>`: the runtime's loop)
  if (f === undefined && !sticky && !rep.includes("$<")) {
    const out = __native.reReplace(h, s, rep)
    if (global) re.lastIndex = 0
    return out
  }
  const unicode = re.unicode
  let from = global ? 0 : sticky ? re.lastIndex : 0
  let out = ""
  let last = 0
  // (one array for every match's positions: reExecInto fills it again while only this holds it)
  let p: int[] = [0, 0, 0, 0, 0, 0, 0, 0]
  while (from <= s.length) {
    p = __native.reExecInto(h, s, from, p)
    if (p.length === 0) {
      if (global || sticky) re.lastIndex = 0
      break
    }
    out += s.slice(last, p[0]!)
    if (f !== undefined) {
      const n = p.length
      out += f(s.slice(p[0]!, p[1]!), __reGroup(s, p, n, 1), __reGroup(s, p, n, 2), __reGroup(s, p, n, 3), __reGroup(s, p, n, 4), __reGroup(s, p, n, 5), __reGroup(s, p, n, 6), __reGroup(s, p, n, 7), __reGroup(s, p, n, 8), __reGroup(s, p, n, 9))
    } else {
      out += __reSubst(h, s, p, rep)
    }
    last = p[1]!
    if (!global) {
      if (sticky) re.lastIndex = p[1]!
      break
    }
    from = __reNext(s, p, unicode)
  }
  out += s.slice(last)
  return out
}

/** (group k of a match, or "" when it has none or it didn't take part) */
function __reGroup(s: string, p: int[], n: int, k: int): string {
  return 2 * k < n && p[2 * k]! >= 0 ? s.slice(p[2 * k]!, p[2 * k + 1]!) : ""
}

/** `s.split(re)`: the parts between matches, with the groups of each match between them. */
export function __reSplit(s: string, re: RegExp, limit?: int): string[] {
  const max = limit ?? 4294967295
  if (!re.sticky) return __native.reSplit(re.__id(), s, max)
  const out: string[] = []
  if (max === 0) return out
  const h = re.__id()
  if (s.length === 0) {
    if (__native.reExec(h, s, 0).length === 0) out.push(s)
    return out
  }
  let last = 0
  let from = 0
  while (from < s.length) {
    const p = __native.reExec(h, s, from)
    if (p.length === 0 || p[0]! >= s.length) break
    if (p[1]! === p[0]! && p[0]! === last) {
      from = p[0]! + 1
      continue
    }
    if (p[1]! === p[0]! && p[0]! >= s.length) break
    out.push(s.slice(last, p[0]!))
    if (out.length === max) return out
    for (let k = 2; k + 1 < p.length; k += 2) {
      if (p[k]! >= 0) out.push(s.slice(p[k]!, p[k + 1]!))
      if (out.length === max) return out
    }
    last = p[1]!
    from = __reNext(s, p, re.unicode)
  }
  out.push(s.slice(last))
  return out
}

/** `s.match(re)`: the first match, or with the `g` flag every match's text. */
/** `s.match(/re/g)`: every match's text (JavaScript's array of strings), or `null`. */
export function __reMatchGlobal(s: string, re: RegExp): string[] | null {
  const h = re.__id()
  const all: string[] = []
  let from = 0
  while (from <= s.length) {
    const p = __native.reExec(h, s, from)
    if (p.length === 0) break
    all.push(s.slice(p[0]!, p[1]!))
    from = __reNext(s, p, re.unicode)
  }
  re.lastIndex = 0
  return all.length === 0 ? null : all
}

export function __reMatch(s: string, re: RegExp): RegExpExecArray | null {
  if (!re.global) return re.exec(s)
  const h = re.__id()
  const all: (string | undefined)[] = []
  let from = 0
  while (from <= s.length) {
    const p = __native.reExec(h, s, from)
    if (p.length === 0) break
    all.push(s.slice(p[0]!, p[1]!))
    from = __reNext(s, p, re.unicode)
  }
  re.lastIndex = 0
  if (all.length === 0) return null
  return new RegExpExecArray(all, -1, s, undefined)
}

/** `s.matchAll(re)`: every match (the `g` flag is required, as in JavaScript). */
export function __reMatchAll(s: string, re: RegExp): RegExpExecArray[] {
  const h = re.__id()
  const out: RegExpExecArray[] = []
  let from = 0
  while (from <= s.length) {
    const p = __native.reExec(h, s, from)
    if (p.length === 0) break
    out.push(__reMatchOf(h, s, p))
    from = __reNext(s, p, re.unicode)
  }
  return out
}

/** `s.search(re)`: where the first match starts, or -1. */
export function __reSearch(s: string, re: RegExp): int {
  const p = __native.reExec(re.__id(), s, 0)
  return p.length === 0 ? -1 : p[0]!
}

// A promise's then/catch/finally (`p.then(f)` is checked as `__then(p, f)`): the callbacks run
// once it settles, and what they return (or throw) settles the promise these return.

/** `p.then(f)`. */
export async function __then<T, R>(p: Promise<T, Error>, f: (v: T) => R throws Error): Promise<R, Error> {
  return f(await p)
}

/** `p.then(f)`, f returning a promise: its value. */
export async function __thenP<T, R>(p: Promise<T, Error>, f: (v: T) => Promise<R, Error> throws Error): Promise<R, Error> {
  return await f(await p)
}

/** `p.then(f, g)`: g only for p's own rejection. */
export async function __then2<T, R>(p: Promise<T, Error>, f: (v: T) => R throws Error, g: (e: Error) => R throws Error): Promise<R, Error> {
  try {
    await p
  } catch (e) {
    return g(e)
  }
  return f(await p)
}

/** One outcome of `Promise.allSettled`. */
export type PromiseSettledResult<T> = { status: "fulfilled", value: T } | { status: "rejected", reason: Error }

/** `Promise.allSettled(ps)`: every outcome, in order, once all have settled (each awaited at
 * once, so none goes unhandled). */
export async function __allSettled<T>(ps: Promise<T, Error>[]): Promise<PromiseSettledResult<T>[]> {
  const settling: Promise<PromiseSettledResult<T>>[] = []
  for (const p of ps) {
    settling.push(__settle(p))
  }
  return await Promise.all(settling)
}

async function __settle<T>(p: Promise<T, Error>): Promise<PromiseSettledResult<T>> {
  try {
    const value = await p
    return { status: "fulfilled", value }
  } catch (e) {
    return { status: "rejected", reason: e }
  }
}

/** `p.catch(g)`. */
export async function __catch<T, R>(p: Promise<T, Error>, g: (e: Error) => R throws Error): Promise<T | R, Error> {
  try {
    return await p
  } catch (e) {
    return g(e)
  }
}

/** `p.finally(h)`: h either way, then p's own outcome. */
export async function __finally<T>(p: Promise<T, Error>, h: () => void throws Error): Promise<T, Error> {
  let failed = false
  let err = new Error("")
  try {
    await p
  } catch (e) {
    failed = true
    err = e
  }
  h()
  if (failed) {
    throw err
  }
  return await p
}

/** A point in time, as JavaScript's: milliseconds since 1970-01-01 UTC (`NaN` when invalid).
 * Local times are the system time zone's. */
export class Date {
  private t: f64 = NaN
  constructor(value?: f64 | string | Date, month?: f64, day?: f64, hours?: f64, minutes?: f64, seconds?: f64, ms?: f64) {
    if (value === undefined) {
      this.t = __native.dateNow()
    } else if (month !== undefined) {
      const v = value
      const y = typeof v === "string" ? __dateNumber(v) : v instanceof Date ? v.t : v
      this.t = __dateClip(__native.dateLocalToUtc(__dateMake(__dateYear(y), month, day ?? 1, hours ?? 0, minutes ?? 0, seconds ?? 0, ms ?? 0)))
    } else if (typeof value === "string") {
      this.t = __dateParse(value)
    } else if (value instanceof Date) {
      this.t = value.t
    } else {
      this.t = __dateClip(value)
    }
  }

  static now(): f64 { return __native.dateNow() }
  static parse(s: string): f64 { return __dateParse(s) }
  static UTC(year: f64, month?: f64, day?: f64, hours?: f64, minutes?: f64, seconds?: f64, ms?: f64): f64 {
    return __dateClip(__dateMake(__dateYear(year), month ?? 0, day ?? 1, hours ?? 0, minutes ?? 0, seconds ?? 0, ms ?? 0))
  }

  getTime(): f64 { return this.t }
  valueOf(): f64 { return this.t }
  setTime(t: f64): f64 {
    this.t = __dateClip(t)
    return this.t
  }
  getTimezoneOffset(): f64 { return this.t !== this.t ? this.t : __native.dateOffset(this.t) }

  getUTCFullYear(): f64 { return __dateField(this.t, 0) }
  getUTCMonth(): f64 { return __dateField(this.t, 1) }
  getUTCDate(): f64 { return __dateField(this.t, 2) }
  getUTCDay(): f64 { return __dateField(this.t, 3) }
  getUTCHours(): f64 { return __dateField(this.t, 4) }
  getUTCMinutes(): f64 { return __dateField(this.t, 5) }
  getUTCSeconds(): f64 { return __dateField(this.t, 6) }
  getUTCMilliseconds(): f64 { return __dateField(this.t, 7) }
  getFullYear(): f64 { return __dateField(this.local(), 0) }
  getMonth(): f64 { return __dateField(this.local(), 1) }
  getDate(): f64 { return __dateField(this.local(), 2) }
  getDay(): f64 { return __dateField(this.local(), 3) }
  getHours(): f64 { return __dateField(this.local(), 4) }
  getMinutes(): f64 { return __dateField(this.local(), 5) }
  getSeconds(): f64 { return __dateField(this.local(), 6) }
  getMilliseconds(): f64 { return __dateField(this.local(), 7) }

  setUTCFullYear(year: f64, month?: f64, day?: f64): f64 { return this.setFields(false, 0, [year, month, day]) }
  setUTCMonth(month: f64, day?: f64): f64 { return this.setFields(false, 1, [month, day]) }
  setUTCDate(day: f64): f64 { return this.setFields(false, 2, [day]) }
  setUTCHours(hours: f64, minutes?: f64, seconds?: f64, ms?: f64): f64 { return this.setFields(false, 3, [hours, minutes, seconds, ms]) }
  setUTCMinutes(minutes: f64, seconds?: f64, ms?: f64): f64 { return this.setFields(false, 4, [minutes, seconds, ms]) }
  setUTCSeconds(seconds: f64, ms?: f64): f64 { return this.setFields(false, 5, [seconds, ms]) }
  setUTCMilliseconds(ms: f64): f64 { return this.setFields(false, 6, [ms]) }
  setFullYear(year: f64, month?: f64, day?: f64): f64 { return this.setFields(true, 0, [year, month, day]) }
  setMonth(month: f64, day?: f64): f64 { return this.setFields(true, 1, [month, day]) }
  setDate(day: f64): f64 { return this.setFields(true, 2, [day]) }
  setHours(hours: f64, minutes?: f64, seconds?: f64, ms?: f64): f64 { return this.setFields(true, 3, [hours, minutes, seconds, ms]) }
  setMinutes(minutes: f64, seconds?: f64, ms?: f64): f64 { return this.setFields(true, 4, [minutes, seconds, ms]) }
  setSeconds(seconds: f64, ms?: f64): f64 { return this.setFields(true, 5, [seconds, ms]) }
  setMilliseconds(ms: f64): f64 { return this.setFields(true, 6, [ms]) }

  toISOString(): string {
    if (this.t !== this.t) throw new RangeError("Invalid time value")
    return this.iso()
  }
  /** (the ISO text of a valid time) */
  private iso(): string {
    return __native.dateIso(this.t)
  }
  toJSON(): string | null { return this.t !== this.t ? null : this.iso() }
  toString(): string {
    if (this.t !== this.t) return "Invalid Date"
    return `${this.toDateString()} ${this.toTimeString()}`
  }
  toDateString(): string {
    if (this.t !== this.t) return "Invalid Date"
    const l = this.local()
    return `${__DAYS[__dateField(l, 3)]!} ${__MONTHS[__dateField(l, 1)]!} ${__datePad(__dateField(l, 2), 2)} ${__dateYearText(__dateField(l, 0))}`
  }
  toTimeString(): string {
    if (this.t !== this.t) return "Invalid Date"
    const l = this.local()
    const off = -__native.dateOffset(this.t)
    const zone = `${off < 0 ? "-" : "+"}${__datePad(Math.floor(Math.abs(off) / 60), 2)}${__datePad(Math.abs(off) % 60, 2)}`
    return `${__datePad(__dateField(l, 4), 2)}:${__datePad(__dateField(l, 5), 2)}:${__datePad(__dateField(l, 6), 2)} GMT${zone} (${__native.dateZoneName(this.t)})`
  }
  toUTCString(): string {
    if (this.t !== this.t) return "Invalid Date"
    const t = this.t
    return `${__DAYS[__dateField(t, 3)]!}, ${__datePad(__dateField(t, 2), 2)} ${__MONTHS[__dateField(t, 1)]!} ${__dateYearText(__dateField(t, 0))} ${__datePad(__dateField(t, 4), 2)}:${__datePad(__dateField(t, 5), 2)}:${__datePad(__dateField(t, 6), 2)} GMT`
  }
  toGMTString(): string { return this.toUTCString() }
  /** (as `en-US` writes it, the default) */
  toLocaleDateString(): string {
    if (this.t !== this.t) return "Invalid Date"
    const l = this.local()
    return `${__dateField(l, 1) + 1}/${__dateField(l, 2)}/${__dateField(l, 0)}`
  }
  toLocaleTimeString(): string {
    if (this.t !== this.t) return "Invalid Date"
    const l = this.local()
    const h = __dateField(l, 4)
    return `${h % 12 === 0 ? 12 : h % 12}:${__datePad(__dateField(l, 5), 2)}:${__datePad(__dateField(l, 6), 2)} ${h < 12 ? "AM" : "PM"}`
  }
  toLocaleString(): string {
    if (this.t !== this.t) return "Invalid Date"
    return `${this.toLocaleDateString()}, ${this.toLocaleTimeString()}`
  }
  /** (what `console.log` shows) */
  __inspect(): string { return this.t !== this.t ? "Invalid Date" : this.iso() }

  /** (the local time as if it were UTC: its fields are the local ones) */
  private local(): f64 { return this.t !== this.t ? this.t : this.t - __native.dateOffset(this.t) * 60000 }
  /** (sets fields from `first` on, `[year, month, day, hours, minutes, seconds, ms]` from
   * year, month, day, hours...: those not given keep their values) */
  private setFields(local: bool, first: int, given: (f64 | undefined)[]): f64 {
    const t = local ? this.local() : this.t
    if (t !== t && first !== 0) return t
    const base = t !== t ? 0 : t
    const f: f64[] = [__dateField(base, 0), __dateField(base, 1), __dateField(base, 2), __dateField(base, 4), __dateField(base, 5), __dateField(base, 6), __dateField(base, 7)]
    for (let i = 0; i < given.length; i++) {
      const g = given[i]
      if (g !== undefined) f[first + i] = g
      else if (i === 0) f[first + i] = NaN
    }
    const m = __dateMake(f[0]!, f[1]!, f[2]!, f[3]!, f[4]!, f[5]!, f[6]!)
    this.t = __dateClip(local ? __native.dateLocalToUtc(m) : m)
    return this.t
  }
}

const __DAYS: string[] = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
const __MONTHS: string[] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

/** (a year as `new Date(y, ...)` reads it: 0 to 99 are 1900 to 1999) */
function __dateYear(y: f64): f64 {
  const i = Math.trunc(y)
  return i >= 0 && i <= 99 ? 1900 + i : y
}

function __dateYearText(y: f64): string {
  return y < 0 ? "-" + __datePad(-y, 6) : __datePad(y, 4)
}

function __datePad(n: f64, width: int): string {
  return `${n}`.padStart(width, "0")
}

/** (a value as `Number(s)` reads it, for `new Date("2020", 1)`) */
function __dateNumber(s: string): f64 {
  return Number(s)
}

/** (JavaScript's TimeClip) */
function __dateClip(t: f64): f64 {
  if (!(Math.abs(t) <= 8.64e15)) return NaN
  return Math.trunc(t) + 0
}

/** (days from 1970-01-01 to the first of a month: `m` 1 to 12) */
function __dateDays(y: f64, m: f64): f64 {
  const yy = m <= 2 ? y - 1 : y
  const era = Math.floor(yy / 400)
  const yoe = yy - era * 400
  const mp = (m + 9) % 12
  const doy = Math.floor((153 * mp + 2) / 5)
  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy
  return era * 146097 + doe - 719468
}

/** (JavaScript's MakeDate(MakeDay(...), MakeTime(...)): a time from fields that may be out of
 * range, `month` 0 to 11) */
function __dateMake(year: f64, month: f64, day: f64, hours: f64, minutes: f64, seconds: f64, ms: f64): f64 {
  const parts = [year, month, day, hours, minutes, seconds, ms]
  for (const p of parts) {
    if (!Number.isFinite(p)) return NaN
  }
  const y = Math.trunc(year)
  const mo = Math.trunc(month)
  const ym = y + Math.floor(mo / 12)
  const mn = ((mo % 12) + 12) % 12
  const days = __dateDays(ym, mn + 1) + Math.trunc(day) - 1
  const time = Math.trunc(hours) * 3600000 + Math.trunc(minutes) * 60000 + Math.trunc(seconds) * 1000 + Math.trunc(ms)
  return days * 86400000 + time
}

/** (a field of time `t`: 0 year, 1 month (0 to 11), 2 day of the month, 3 weekday, 4 hours,
 * 5 minutes, 6 seconds, 7 milliseconds) */
function __dateField(t: f64, which: int): f64 {
  if (t !== t) return NaN
  const day = Math.floor(t / 86400000)
  const inDay = t - day * 86400000
  if (which === 3) return ((day + 4) % 7 + 7) % 7
  if (which === 4) return Math.floor(inDay / 3600000)
  if (which === 5) return Math.floor(inDay / 60000) % 60
  if (which === 6) return Math.floor(inDay / 1000) % 60
  if (which === 7) return inDay % 1000
  const z = day + 719468
  const era = Math.floor(z / 146097)
  const doe = z - era * 146097
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365)
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100))
  const mp = Math.floor((5 * doy + 2) / 153)
  const m = mp < 10 ? mp + 3 : mp - 9
  if (which === 1) return m - 1
  if (which === 2) return doy - Math.floor((153 * mp + 2) / 5) + 1
  return yoe + era * 400 + (m <= 2 ? 1 : 0)
}

/** (`Date.parse`: the ISO format, `2019-01-16`, `2019-01-16T08:30:00.000Z`, `+002019-01`, with
 * a time in local time unless a zone is given; a space for the `T` too. Otherwise `NaN`.) */
function __dateParse(s: string): f64 {
  // (toISOString's own form: read in the runtime)
  const iso = __native.dateParseIso(s)
  if (iso === iso) return __dateClip(iso)
  let i = 0
  const n = s.length
  const digits = (count: int): f64 => {
    if (i + count > n) return -1
    let v = 0
    for (let k = 0; k < count; k++) {
      const c = s.charCodeAt(i + k)
      if (c < 48 || c > 57) return -1
      v = v * 10 + (c - 48)
    }
    i += count
    return v
  }
  let sign = 1
  let year: f64 = 0
  if (s[0] === "+" || s[0] === "-") {
    sign = s[0] === "-" ? -1 : 1
    i = 1
    year = digits(6)
    if (year < 0 || (sign < 0 && year === 0)) return NaN
  } else {
    year = digits(4)
    if (year < 0) return NaN
  }
  year *= sign
  let month: f64 = 1
  let day: f64 = 1
  if (i < n && s[i] === "-") {
    i++
    month = digits(2)
    if (month < 1 || month > 12) return NaN
    if (i < n && s[i] === "-") {
      i++
      day = digits(2)
      if (day < 1 || day > 31) return NaN
    }
  }
  let h: f64 = 0
  let mi: f64 = 0
  let sec: f64 = 0
  let ms: f64 = 0
  let hasTime = false
  if (i < n && (s[i] === "T" || s[i] === "t" || s[i] === " ")) {
    hasTime = true
    i++
    h = digits(2)
    if (h < 0 || i >= n || s[i] !== ":") return NaN
    i++
    mi = digits(2)
    if (mi < 0) return NaN
    if (i < n && s[i] === ":") {
      i++
      sec = digits(2)
      if (sec < 0) return NaN
      if (i < n && (s[i] === "." || s[i] === ",")) {
        i++
        const start = i
        let frac = 0
        let scale = 1
        while (i < n && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) {
          if (i - start < 3) {
            frac = frac * 10 + (s.charCodeAt(i) - 48)
            scale *= 10
          }
          i++
        }
        if (i === start) return NaN
        ms = Math.floor((frac * 1000) / scale)
      }
    }
    if (h > 24 || mi > 59 || sec > 59 || (h === 24 && (mi > 0 || sec > 0 || ms > 0))) return NaN
  }
  let offset: f64 = 0
  let zoned = !hasTime
  if (i < n && (s[i] === "Z" || s[i] === "z")) {
    zoned = true
    i++
  } else if (i < n && hasTime && (s[i] === "+" || s[i] === "-")) {
    const zs = s[i] === "-" ? -1 : 1
    i++
    const oh = digits(2)
    if (oh < 0) return NaN
    if (i < n && s[i] === ":") i++
    const om = digits(2)
    if (om < 0 || oh > 23 || om > 59) return NaN
    offset = zs * (oh * 60 + om)
    zoned = true
  }
  if (i !== n) return NaN
  const t = __dateMake(year, month - 1, day, h, mi, sec, ms)
  return __dateClip(zoned ? t - offset * 60000 : __native.dateLocalToUtc(t))
}

/** (the suites running, innermost last, by their full names: tests declared in functions a
 * suite calls, `it(...)` in a helper, are named by them) */
const __suites: string[] = []

/** (a suite's full name, inside the suites running) */
export function __suiteName(name: string): string {
  return __suites.length > 0 ? `${__suites[__suites.length - 1]!} > ${name}` : name
}

export function __suiteEnter(full: string): void {
  __suites.push(full)
}

export function __suiteLeave(): void {
  __suites.pop()
}

/** (a test declared in a function a suite calls: named inside the suites running) */
export function __testHere(name: string, f: () => void, after?: () => void): void {
  if (after === undefined) __test(__suiteName(name), () => f())
  else __test(__suiteName(name), () => f(), () => after())
}

/** Deno's standard output: `Deno.stdout.write(bytes)` */
export class __DenoStdout {
  write(data: u8[]): Promise<int> {
    process.stdout.write(__native.bytesToString(data))
    return Promise.resolve(data.length)
  }
  writeSync(data: u8[]): int {
    process.stdout.write(__native.bytesToString(data))
    return data.length
  }
}

/** The part of Deno's global programs written for Deno use most: its arguments, output,
 * files and exit */
export class Deno {
  static args: string[] = process.argv.slice(2)
  static stdout: __DenoStdout = new __DenoStdout()
  static exit(code?: int): void {
    process.exit(code ?? 0)
  }
  static readTextFileSync(path: string): string throws Error {
    const text = __native.readFile(path)
    const err = __native.takeError()
    if (err !== "") throw new Error(err)
    return text
  }
  static async readTextFile(path: string): Promise<string, Error> {
    return Deno.readTextFileSync(path)
  }
}
